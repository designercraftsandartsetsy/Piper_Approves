# From your Etsy app in the Etsy Developer portal (https://www.etsy.com/developers/your-apps)
ETSY_KEYSTRING=your_etsy_keystring_here

# Must exactly match the "Redirect URI" registered on your Etsy app
ETSY_REDIRECT_URI=http://localhost:3000/etsy-callback

# Space-separated Etsy OAuth scopes. Adjust as needed.
ETSY_SCOPES=listings_r listings_w shops_r

PORT=3000
